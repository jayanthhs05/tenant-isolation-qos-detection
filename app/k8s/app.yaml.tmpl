# Per-tenant Deployment + Service for the demo notes-api, rendered by scripts/deploy-app.sh
# (envsubst on ${TENANT} / ${IMAGE}) and applied into the tenant's own namespace. One
# Deployment+Service per tenant namespace — each tenant's pod gets its own local SQLite file
# (no shared DB), so app-level data isolation falls straight out of infra-level namespace
# isolation rather than needing its own access-control logic.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notes-api
  namespace: ${TENANT}
  labels:
    app: notes-api
    tenant: ${TENANT}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: notes-api
      tenant: ${TENANT}
  template:
    metadata:
      labels:
        app: notes-api
        tenant: ${TENANT}
    spec:
      serviceAccountName: ${TENANT}-app
      containers:
        - name: notes-api
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          env:
            - name: TENANT_ID
              value: ${TENANT}
            - name: POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "250m"
              memory: "128Mi"
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8000
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8000
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: notes-api
  namespace: ${TENANT}
  labels:
    app: notes-api
    tenant: ${TENANT}
spec:
  selector:
    app: notes-api
    tenant: ${TENANT}
  ports:
    - port: 80
      targetPort: 8000
